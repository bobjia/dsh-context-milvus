{
  "mcpServers": {
    "context-milvus": {
      "command": "npx",
      "args": ["-y", "codex-context-milvus", "mcp"],
      "env_vars": ["MILVUS_ADDRESS", "MILVUS_TOKEN", "MILVUS_COLLECTION", "MILVUS_EMBEDDING_DIM", "EMBEDDING_ENDPOINT", "EMBEDDING_API_KEY", "EMBEDDING_MODEL", "CONTEXT_MILVUS_WORKSPACE", "ADR_ENABLED", "ADR_ROOT", "ADR_COLLECTION", "CONTEXT_MILVUS_ADR_WRITE", "HYBRID_MODE", "INDEX_EXTENSIONS", "INDEX_IGNORE_DIRS", "IGNORE_PATTERNS", "MERKLE_FILE_PATH", "SPEC_ROOT", "PLAN_ROOT"],
      "tool_timeout_sec": 1800
    }
  }
}
