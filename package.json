{
  "name": "dsh-context-milvus",
  "version": "0.5.0",
  "description": "DSH plugin for semantic code search via Milvus vector database",
  "type": "module",
  "files": [
    "dist",
    "client",
    "cordis-entry.yml",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "main": "dist/plugins/dsh-context-milvus/index.js",
  "types": "dist/plugins/dsh-context-milvus/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugins/dsh-context-milvus/index.d.ts",
      "default": "./dist/plugins/dsh-context-milvus/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage"
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "^0.0.1-rc.1",
    "@zilliz/milvus2-sdk-node": "^3.0.4",
    "ignore": "^7.0.6",
    "js-yaml": "^5.4.1",
    "tree-sitter": "^0.25.1",
    "tree-sitter-c-sharp": "^0.23.5",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-scala": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/jest": "^29.5.0",
    "@types/js-yaml": "^4.0.9",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0"
  }
}
