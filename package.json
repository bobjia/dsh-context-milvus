{
  "name": "dsh-context-milvus-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage",
    "build": "npm run build -w dsh-context-milvus-core && npm run build -w dsh-context-milvus",
    "typecheck": "npm run build -w dsh-context-milvus-core && tsc -p packages/dsh/tsconfig.json --noEmit",
    "test:eval": "node --test scripts/eval/retrieval/lib/*.test.mjs",
    "test:eval-agent": "node --test scripts/eval/agent/lib/*.test.mjs",
    "test:eval-telemetry": "node --test scripts/eval/telemetry/lib/*.test.mjs",
    "eval:telemetry": "node scripts/eval/telemetry/run.mjs"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.11.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0"
  }
}
